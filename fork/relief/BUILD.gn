# Relief im Chromium-Build (//relief). MIT-Lizenz wie das Relief-Repository.
#
# Die Rust-Crates liegen im Relief-Repository unter crates/ (Quelle der
# Wahrheit ist der Cargo-Workspace); scripts/fork-apply.sh kopiert ihre
# Quellen nach //relief/crates/. Aufbau und Datenfluss:
# plan/spezifikation/01-chromium-integration.md und 02-rust-core-und-bridge.md.

import("//build/rust/rust_static_library.gni")

# Datenmodell und Delta-Format, browserfrei. Ohne das Cargo-Feature
# `perception`: a11y-perception liegt nicht in //third_party/rust, der
# Konverter aus CDP-Aufnahmen wird im Browser nicht gebraucht.
rust_static_library("relief_model_rs") {
  visibility = [ ":*" ]

  # Fester Crate-Name, damit `use relief_model::…` in relief-bridge im
  # Cargo- und im GN-Build gleich bleibt (GN vergibt sonst einen
  # verfremdeten Namen, siehe build/rust/rust_static_library.gni).
  crate_name = "relief_model"
  crate_root = "crates/relief-model/src/lib.rs"
  edition = "2021"
  sources = [
    "crates/relief-model/src/delta.rs",
    "crates/relief-model/src/fact.rs",
    "crates/relief-model/src/graph.rs",
    "crates/relief-model/src/id.rs",
    "crates/relief-model/src/lib.rs",
    "crates/relief-model/src/node.rs",
    "crates/relief-model/src/role.rs",
  ]
  deps = [ "//third_party/rust/serde/v1:lib" ]
}

# Interaction Graph, Befehle in Sprache und Aktionsvalidierung, browserfrei
# (dieselbe Logik wie im CDP-Host).
rust_static_library("relief_interaction_rs") {
  visibility = [ ":*" ]
  crate_name = "relief_interaction"
  crate_root = "crates/relief-interaction/src/lib.rs"
  edition = "2021"
  sources = [
    "crates/relief-interaction/src/command.rs",
    "crates/relief-interaction/src/graph.rs",
    "crates/relief-interaction/src/lib.rs",
    "crates/relief-interaction/src/page.rs",
    "crates/relief-interaction/src/resolve.rs",
    "crates/relief-interaction/src/respond.rs",
    "crates/relief-interaction/src/session.rs",
    "crates/relief-interaction/src/validate.rs",
  ]
  deps = [
    ":relief_model_rs",
    "//third_party/rust/serde/v1:lib",
  ]
}

# Runtime hinter der Grenze und cxx-Bridge (Variante A, in-process).
rust_static_library("relief_bridge_rs") {
  visibility = [ ":*" ]
  crate_name = "relief_bridge"
  crate_root = "crates/relief-bridge/src/lib.rs"
  edition = "2021"
  sources = [
    "crates/relief-bridge/src/command.rs",
    "crates/relief-bridge/src/cxx_bridge.rs",
    "crates/relief-bridge/src/inspector.rs",
    "crates/relief-bridge/src/lib.rs",
    "crates/relief-bridge/src/runtime.rs",
  ]
  cxx_bindings = [ "crates/relief-bridge/src/cxx_bridge.rs" ]

  # Der von cxx erzeugte Code braucht `unsafe`; der eigene Code verbietet es
  # per `#![deny(unsafe_code)]` außerhalb des Bridge-Moduls.
  allow_unsafe = true
  deps = [
    ":relief_interaction_rs",
    ":relief_model_rs",
    "//third_party/rust/serde/v1:lib",
    "//third_party/rust/serde_json/v1:lib",
  ]
}

# Inspector-Ressourcen als Header (statt grit, → inspector/embed_resources.py).
action("inspector_resources") {
  visibility = [ ":*" ]
  script = "inspector/embed_resources.py"
  sources = [
    "inspector/resources/inspector.css",
    "inspector/resources/inspector.html",
    "inspector/resources/inspector.js",
  ]
  outputs = [ "$target_gen_dir/inspector/inspector_resources.h" ]
  args = rebase_path(outputs, root_build_dir) +
         rebase_path(sources, root_build_dir)
}

# Tab-Helfer: eigener AXTree je Frame (Weg B), Deltas an die Rust-Runtime
# auf eigener Sequenz, Rückweg über AXActionData; Aufgaben-Runner
# (--relief-run). Nur mit --enable-relief.
source_set("relief") {
  sources = [
    "bridge/ax_tree_mirror.cc",
    "bridge/ax_tree_mirror.h",
    "bridge/runtime_host.cc",
    "bridge/runtime_host.h",
    "inspector/relief_inspector.cc",
    "inspector/relief_inspector.h",
    "inspector/relief_inspector_ui.cc",
    "inspector/relief_inspector_ui.h",
    "relief_attach.h",
    "relief_switches.h",
    "relief_tab_helper.cc",
    "relief_tab_helper.h",
    "relief_task_runner.cc",
    "relief_task_runner.h",
  ]
  deps = [
    ":inspector_resources",
    ":relief_bridge_rs",
    "//base",
    "//chrome/app:generated_resources",
    "//chrome/browser/profiles:profile",
    "//chrome/browser/ui:browser_actions",
    "//chrome/browser/ui/actions:actions_headers",
    "//chrome/browser/ui/browser_window:browser_window",
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/views/side_panel",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/input",
    "//components/tabs:public",
    "//components/vector_icons",
    "//content/public/browser",
    "//third_party/abseil-cpp:absl",
    "//third_party/blink/public/common",
    "//net",
    "//ui/accessibility",
    "//ui/actions",
    "//ui/events:dom_keycode_converter",
    "//ui/events:events_base",
    "//ui/gfx/geometry",
    "//url",
  ]
}

# Browser-Tests der Integrationspunkte; hier eingehängt, damit GN
# //relief/testing lädt, ohne dass ein Chromium-Build-File es nennt.
group("relief_tests") {
  testonly = true
  deps = [ "//relief/testing:relief_browsertests" ]
}
