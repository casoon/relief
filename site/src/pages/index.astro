---
import { readFile } from 'node:fs/promises';
import {
  Badge,
  Badges,
  Facts,
  Faq,
  Features,
  Hero,
  Quickstart,
  ReleaseHighlights,
} from '@casoon/pages-theme/components';
import Base from '@casoon/pages-theme/layouts/Base.astro';
import config from 'virtual:casoon-pages/config';
import { parseChangelog } from '@casoon/pages-theme/lib/changelog';
// Animierte SVGs, mit castwright gebaut aus site/captures/relief*.terminal.yaml: Auszug eines
// echten Laufs von relief-cdp über spike/tasks/01-shop-clean.txt (site/captures/shop-clean.txt,
// siehe site/captures/excerpt.sh). Die schmale Szene hat 48 Spalten und bleibt auf dem Telefon lesbar.
import reliefNarrowSvg from '../../captures/relief-narrow.svg?url';
import reliefSvg from '../../captures/relief.svg?url';

// Skip "Unreleased": it has no version to show as "New in v…" yet.
const latestRelease = config.changelog
  ? parseChangelog(await readFile(config.changelog, 'utf8')).find(
      (r) => r.version.toLowerCase() !== 'unreleased'
    )
  : undefined;
---

<Base>
  <Hero
    eyebrow="CASOON research project · in development"
    title="A website is a surface. Relief makes its structure tangible."
    lead="Relief is a research browser built on Chromium. It reads the accessibility tree inside the browser, turns it into a semantic model of the page and lets people operate the page by intent — alongside VoiceOver or NVDA, not instead of them."
  >
    <Badges>
      <Badge>Research project</Badge>
      <Badge>Chromium 154</Badge>
      <Badge>Rust core</Badge>
      <Badge>macOS first</Badge>
      <Badge>MIT</Badge>
    </Badges>
    <picture slot="output">
      <source media="(max-width: 640px)" srcset={reliefNarrowSvg} width="427.2" height="512" />
      <img
        class="terminal-demo"
        src={reliefSvg}
        width="578.4"
        height="422"
        alt="Terminal, excerpt of a real relief-cdp run against a test shop page (German interface). Command: cargo run -p relief-cdp -- run spike/tasks/01-shop-clean.txt. Input „Öffne den Warenkorb“: Relief answers that this is ambiguous and lists the link „Warenkorb (0)“ in the main menu and the button „In den Warenkorb“ in main. Input „klicke In den Warenkorb“: Activate on the button, focus on it, new text „Warenkorb (1)“ and „Größe 43 in den Warenkorb gelegt.“. Input „klicke Jetzt kaufen“: confirmation needed (High), because the name contains „kaufen“; „ja“ confirms exactly this one action. Summary: Erwartungen: 16 erfüllt, 0 nicht erfüllt."
      />
    </picture>
  </Hero>

  <Facts
    items={[
      { value: '≤ 1.1 ms', label: 'p95 from accessibility packet to updated page model' },
      { value: '9', label: 'small patches outside Relief’s own directory in the Chromium fork' },
      { value: '13 / 13', label: 'recorded pages with correct page type and primary action' },
      { value: 'unchanged', label: 'VoiceOver output with Relief running, compared step by step' },
    ]}
  />

  <Features
    heading="What Relief is built to do"
    items={[
      {
        title: 'Understand the page, not just read it',
        body: 'Page type, functional groups, the primary action and what changed — derived from Chromium’s own accessibility tree, including cross-site iframes such as consent dialogs.',
      },
      {
        title: 'Operate by intent, safely',
        body: '“What can I do here?”, “add size 43 to the cart”. Every action runs through a validated plan in Rust; risky actions need an explicit confirmation. A model may suggest, never act.',
      },
      {
        title: 'Say where a statement comes from',
        body: 'Every answer carries its certainty: known from the page, inferred, or uncertain. Guesses are never presented as facts.',
      },
      {
        title: 'Test accessibility the way people use it',
        body: 'The same core runs as a test mode: form journeys, focus after errors, live announcements and the real VoiceOver output, checked in the real browser.',
      },
    ]}
  />

  <Quickstart
    title="Where the project stands"
    lead="Phase 0 — feasibility inside a real Chromium build — is complete. The user-facing surfaces of phase 1 now run in the fork."
    steps={[
      'Done: Chromium fork builds on Apple silicon; accessibility tree → Rust → page model → action → result, measured on real sites. VoiceOver keeps working unchanged next to Relief.',
      'Done: actions through Chromium’s accessibility actions, an inspector with findings, a command bar, keyboard hints, a form assistant, consent handling and a semantic view.',
      'Done: speech — a talk button with live microphone, recognition on the device, spoken answers; “cancel” interrupts at once.',
      'Done: ability profiles — output, input and presentation adapted to abilities, globally or per site, stored locally only.',
      'Done for testing: form assertions, headless runs with JUnit reports, Playwright access to the page model.',
      'Next: real screen-reader output in tests, an accessibility baseline for Relief’s own interface checked with VoiceOver, the runtime in a sandboxed utility process.',
    ]}
  />

  {latestRelease && <ReleaseHighlights release={latestRelease} />}

  <Faq
    items={[
      {
        q: 'Does Relief replace a screen reader like VoiceOver or NVDA?',
        a: 'No. Relief runs alongside VoiceOver and NVDA rather than instead of them, and the Chromium fork keeps VoiceOver output unchanged while Relief is active.',
      },
      {
        q: 'What parts of Relief are actually usable today?',
        a: 'Phase 0 — feasibility inside a real Chromium build — is complete. The phase 1 surfaces run in the fork: the Relief panel, command bar, semantic inspector, semantic view, speech, bookmarks, the form assistant and consent handling.',
      },
      {
        q: 'How does Relief handle cookie and consent dialogs?',
        a: 'It detects consent dialogs, including those in cross-site iframes, and can decline them on request — it never accepts a consent dialog on a person’s behalf.',
      },
      {
        q: 'Can a model take actions on a page by itself?',
        a: 'No. Every action runs through a validated plan in Rust before it reaches the page, and a model may only suggest an action, never execute one directly; risky actions need an explicit confirmation.',
      },
      {
        q: 'Can Relief’s behavior be tested automatically?',
        a: 'Yes. The same core runs as a test mode with form assertions, headless runs that produce a JUnit report, and Playwright access through the CDP domain Relief.*.',
      },
    ]}
  />
</Base>

<style>
  /* Never scale the SVG beyond a readable terminal size. */
  .terminal-demo {
    display: block;
    width: 100%;
    max-width: 720px;
    height: auto;
    margin: 0 auto;
  }
</style>
